[Unit]
Description=Canopy Guide chat API (FastAPI)
After=network-online.target ollama.service
Wants=ollama.service

[Service]
User=canopy
WorkingDirectory=/opt/app/backend
EnvironmentFile=/etc/canopy/api.env
# --proxy-headers: Caddy passes the visitor's IP, which the per-IP rate limit needs.
ExecStart=/opt/app/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
